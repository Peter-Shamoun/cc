        <mxCell id="chat-box6" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:14px&quot;&gt;COGNITO TOKEN&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;Names the customer · from the access path&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="chat-frame2">
