        <mxCell id="chat-agent13" value="&lt;b style=&quot;font-size:15px;letter-spacing:0.04em&quot;&gt;ANALYZER · B1 (SHIPPED)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Haiku 5.5 · one agent · free SQL over sem.*&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Playbook v1 (14 rules from TRAIN misses)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;3 similar solved TRAIN examples (BM25)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Dictionary with derivations · enum profile · value lookup&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Sealed test 93.8% vs 79.2% base (+14.6 pp)&lt;/span&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="chat-frame9">
