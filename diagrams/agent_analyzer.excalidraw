      "seed": 2066328173,
      "version": 441,
      "versionNonce": 1069867354,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793040000000,
      "created": 1792788002095,
      "link": null,
      "locked": false,
      "text": "Core Principle: Enforce the semantic layer. This is a schema of curated tables that the agent can query to answer nearly every question\n(the full lossless schema was needed in 1 of 225 benchmark runs). We do this to save tokens, and make the agent write queries in a simple interface.",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Core Principle: Enforce the semantic layer. This is a schema of curated tables that the agent can query to answer nearly every question\n(the full lossless schema was needed in 1 of 225 benchmark runs). We do this to save tokens, and make the agent write queries in a simple interface.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
