    {
      "id": "9kVIq4ZuaAcGZISSBzOV3",
      "type": "text",
      "x": -2784.5200443200833,
      "y": 952.5010970829117,
      "width": 2486.4,
      "height": 70.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
