   "final_sql": "WITH latest_claims AS ( SELECT claim_id, principal_diagnosis_code FROM sem.claims WHERE is_latest_submission ), proc_claims AS ( SELECT DISTINCT cl.procedure_code, l.claim_id, l.principal_diagnosis_code FROM sem.claim_lines cl JOIN latest_claims l ON l.claim_id = cl.claim_id WHERE cl.is_latest_submission ), counts AS ( SELECT procedure_code, principal_diagnosis_code, COUNT(*) AS n_claims FROM proc_claims GROUP BY 1, 2 ), ranked AS ( SELECT procedure_code, principal_diagnosis_code, n_claims, SUM(n_claims) OVER (PARTITION BY procedure_code) AS total_claims, ROW_NUMBER() OVER ( PARTITION BY procedure_code ORDER BY n_claims DESC, principal_diagnosis_code ASC) AS rn FROM counts ) SELECT procedure_code, principal_diagnosis_code AS top_principal_diagnosis, n_claims AS claims_with_top_dx, total_claims, ROUND(100.0 * n_claims / total_claims, 1) AS top_dx_share_pct FROM ranked WHERE rn = 1 ORDER BY procedure_code",
