   "final_sql": "WITH submissions AS ( SELECT claim_key, MIN(submission_date) AS first_submission_date, MIN(service_date_from) AS service_date FROM sem.claims GROUP BY claim_key ), primary_payer AS ( SELECT claim_key, MIN(payer_class) AS payer_class FROM sem.claims WHERE payer_responsibility = 'P' GROUP BY claim_key ), lags AS ( SELECT p.payer_class, date_diff('day', s.service_date, s.first_submission_date) AS lag_days FROM primary_payer p JOIN submissions s USING (claim_key) ) SELECT payer_class, COUNT(*) AS claims, ROUND(AVG(lag_days), 2) AS avg_lag_days, MEDIAN(lag_days) AS median_lag_days, COUNT(*) FILTER (WHERE lag_days > 90) AS claims_lag_over_90 FROM lags GROUP BY payer_class ORDER BY payer_class",
