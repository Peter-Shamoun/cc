   "final_sql": "WITH pairs AS ( SELECT claim_key, payer_key, any_value(payer_class) AS payer_class, COUNT(DISTINCT check_or_eft_number) AS trace_count, BOOL_OR(is_reversal) AS has_reversal, BOOL_OR(is_current_adjudication) AS has_current, COALESCE(SUM(paid_amount) FILTER (WHERE is_current_adjudication), 0) AS current_paid FROM sem.remit_claims GROUP BY claim_key, payer_key ), multi AS ( SELECT * FROM pairs WHERE trace_count >= 2 ) SELECT payer_class, COUNT(*) AS multi_trace_pairs, COUNT(*) FILTER (WHERE has_reversal) AS pairs_with_reversal, COUNT(*) FILTER (WHERE NOT has_current) AS pairs_without_current, ROUND(SUM(current_paid), 2) AS current_paid_amount FROM multi GROUP BY payer_class ORDER BY payer_class",
