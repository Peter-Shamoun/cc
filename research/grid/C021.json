      "final_sql": "WITH primary_sub AS (\n  SELECT claim_key, payer_key, min(payer_class) AS payer_class, min(submission_date) AS first_submission\n  FROM sem.claims\n  WHERE payer_responsibility = 'P'\n  GROUP BY claim_key, payer_key\n),\npaid AS (\n  SELECT s.payer_class, date_diff('day', s.first_submission, r.payment_date) AS days_to_pay\n  FROM sem.remit_claims r\n  JOIN primary_sub s ON s.claim_key = r.claim_key AND s.payer_key = r.payer_key\n  WHERE r.is_current_adjudication AND r.paid_amount > 0\n)\nSELECT payer_class, count(*) AS paid_claims,\n       round(median(days_to_pay), 1) AS median_days,\n       round(quantile_cont(days_to_pay, 0.9), 1) AS p90_days\nFROM paid GROUP BY payer_class ORDER BY payer_class",
      "sql_execs": 3,
      "repairs": 0,
      "seconds": 0.0185,
      "pass": true
    },
