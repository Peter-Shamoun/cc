      "final_sql": "WITH denied AS (\n  SELECT claim_key, payer_key, claim_payer_key\n  FROM sem.remit_claims\n  WHERE is_current_adjudication AND is_denied\n),\ncodes AS (\n  SELECT a.carc_code, d.claim_payer_key\n  FROM sem.adjustments a\n  JOIN denied d ON d.claim_key = a.claim_key AND d.payer_key = a.payer_key\n  WHERE a.is_current_adjudication AND a.group_code = 'CO' AND a.is_denial_carc\n)\nSELECT carc_code, count(DISTINCT claim_payer_key) AS denied_claim_payers\nFROM codes GROUP BY carc_code\nORDER BY denied_claim_payers DESC, carc_code\nLIMIT 5",
