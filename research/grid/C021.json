      "final_sql": "WITH pair AS (\n  SELECT min(payer_class) AS payer_class, claim_payer_key,\n         count(DISTINCT check_or_eft_number) AS traces,\n         bool_or(is_reversal) AS has_reversal,\n         bool_or(is_current_adjudication) AS has_current,\n         coalesce(sum(paid_amount) FILTER (WHERE is_current_adjudication), 0) AS current_paid\n  FROM sem.remit_claims GROUP BY claim_payer_key\n),\nclasses AS (\n  SELECT DISTINCT payer_class FROM sem.remit_claims\n),\nmulti AS (\n  SELECT * FROM pair WHERE traces >= 2\n)\nSELECT c.payer_class,\n       count(m.claim_payer_key) AS multi_trace_pairs,\n       count(m.claim_payer_key) FILTER (WHERE m.has_reversal) AS pairs_with_reversal,\n       count(m.claim_payer_key) FILTER (WHERE NOT m.has_current) AS pairs_without_current,\n       round(coalesce(sum(m.current_paid), 0), 2) AS current_paid\nFROM classes c\nLEFT JOIN multi m ON m.payer_class = c.payer_class\nGROUP BY c.payer_class ORDER BY c.payer_class",
