      "final_sql": "WITH claim_cpt AS (\n  SELECT DISTINCT cl.procedure_code, c.claim_key, c.principal_diagnosis_code\n  FROM sem.claim_lines cl\n  JOIN sem.claims c ON c.claim_id = cl.claim_id\n  WHERE c.is_latest_submission AND cl.is_latest_submission\n),\ncounts AS (\n  SELECT procedure_code, principal_diagnosis_code, count(*) AS pair_claims\n  FROM claim_cpt GROUP BY 1, 2\n),\nranked AS (\n  SELECT procedure_code, principal_diagnosis_code, pair_claims,\n         sum(pair_claims) OVER (PARTITION BY procedure_code) AS claims_with_procedure,\n         row_number() OVER (PARTITION BY procedure_code ORDER BY pair_claims DESC, principal_diagnosis_code) AS rn\n  FROM counts\n)\nSELECT procedure_code, principal_diagnosis_code, pair_claims, claims_with_procedure,\n       round(100.0 * pair_claims / claims_with_procedure, 1) AS top_dx_share_pct\nFROM ranked WHERE rn = 1 ORDER BY procedure_code",
