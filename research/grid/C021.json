      "final_sql": "WITH pairs AS (\n  SELECT claim_payer_key, min(payer_class) AS payer_class, count(*) AS n_events,\n         count(*) FILTER (WHERE is_current_adjudication AND NOT is_denied) AS current_paid_or_not_denied\n  FROM sem.remit_claims\n  GROUP BY claim_payer_key\n),\nlabeled AS (\n  SELECT payer_class, claim_payer_key,\n         (n_events = 1 AND current_paid_or_not_denied = 1) AS first_pass\n  FROM pairs\n)\nSELECT payer_class,\n       count(*) AS remitted_pairs,\n       count(*) FILTER (WHERE first_pass) AS first_pass_resolved,\n       round(100.0 * count(*) FILTER (WHERE first_pass) / count(*), 2) AS first_pass_rate_pct\nFROM labeled GROUP BY payer_class ORDER BY payer_class",
