      "final_sql": "WITH replacements AS (\n  SELECT submission_month, claim_key, charge_amount\n  FROM sem.claims\n  WHERE frequency_code = '7'\n)\nSELECT submission_month, count(*) AS replacement_claims, round(sum(charge_amount), 2) AS billed_charge\nFROM replacements\nGROUP BY submission_month\nORDER BY submission_month",
