      "final_sql": "WITH primary_claim AS (\n  SELECT claim_key, payer_class, date_diff('day', service_date_from, submission_date) AS lag_days\n  FROM sem.claims\n  WHERE payer_responsibility = 'P'\n),\nchecked AS (\n  SELECT payer_class, count(*) AS claims, count(DISTINCT claim_key) AS distinct_claims,\n         round(avg(lag_days), 2) AS avg_lag_days, median(lag_days) AS median_lag_days,\n         count(*) FILTER (WHERE lag_days > 90) AS claims_lag_over_90, sum(lag_days) AS sum_lag\n  FROM primary_claim GROUP BY payer_class\n)\nSELECT payer_class, claims, avg_lag_days, median_lag_days, claims_lag_over_90\nFROM checked ORDER BY payer_class",
