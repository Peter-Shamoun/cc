{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimclarity.local/api/contract/v1.schema.json",
  "title": "ClaimClarity chat stream contract",
  "version": "1.3.0",
  "description": "One JSON object per SSE data: line. See api/CONTRACT.md. Validate an event against #/$defs/StreamEvent.",
  "$ref": "#/$defs/StreamEvent",
  "$defs": {
    "ID": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_:.-]+$"
    },
    "Sensitivity": {
      "enum": [
        "none",
        "deidentified",
        "limited",
        "phi"
      ]
    },
    "ColumnType": {
      "enum": [
        "string",
        "integer",
        "number",
        "currency",
        "percent",
        "date",
        "datetime",
        "boolean",
        "code"
      ]
    },
    "Column": {
      "type": "object",
      "required": [
        "key",
        "label",
        "type"
      ],
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        },
        "format": {
          "type": "string"
        },
        "phi": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ColumnSummary": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        }
      },
      "additionalProperties": true
    },
    "StepError": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": true
    },
    "ModelRef": {
      "type": "object",
      "required": [
        "model"
      ],
      "properties": {
        "model": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "small",
            "medium",
            "large"
          ]
        },
        "provider": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "Usage": {
      "type": "object",
      "required": [
        "queries",
        "elapsedMs"
      ],
      "properties": {
        "queries": {
          "type": "integer",
          "minimum": 0
        },
        "elapsedMs": {
          "type": "integer",
          "minimum": 0
        },
        "tokens": {
          "type": "object",
          "required": [
            "input",
            "output"
          ],
          "properties": {
            "input": {
              "type": "integer",
              "minimum": 0
            },
            "output": {
              "type": "integer",
              "minimum": 0
            },
            "cacheRead": {
              "type": "integer",
              "minimum": 0
            },
            "cacheWrite": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        },
        "costIsEstimate": {
          "type": "boolean"
        },
        "latency": {
          "type": "object",
          "required": [
            "totalMs"
          ],
          "properties": {
            "firstEventMs": {
              "type": "integer",
              "minimum": 0
            },
            "firstStepMs": {
              "type": "integer",
              "minimum": 0
            },
            "firstTokenMs": {
              "type": "integer",
              "minimum": 0
            },
            "modelMs": {
              "type": "integer",
              "minimum": 0
            },
            "sqlMs": {
              "type": "integer",
              "minimum": 0
            },
            "queueMs": {
              "type": "integer",
              "minimum": 0
            },
            "totalMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        },
        "models": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "model",
              "inputTokens",
              "outputTokens"
            ],
            "properties": {
              "model": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "inputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "outputTokens": {
                "type": "integer",
                "minimum": 0
              },
              "costUsd": {
                "type": "number",
                "minimum": 0
              },
              "calls": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "Suggestion": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "text": {
          "type": "string",
          "maxLength": 300
        }
      },
      "additionalProperties": true
    },
    "Choice": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ID"
        },
        "label": {
          "type": "string",
          "maxLength": 200
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "TextPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "text"
      ],
      "properties": {
        "type": {
          "const": "text"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ReasoningPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "summary"
      ],
      "properties": {
        "type": {
          "const": "reasoning"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "StatusPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "label"
      ],
      "properties": {
        "type": {
          "const": "status"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ToolCallPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "tool",
        "label",
        "state"
      ],
      "properties": {
        "type": {
          "const": "tool_call"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "state": {
          "enum": [
            "running",
            "ok",
            "error"
          ]
        },
        "input": {
          "type": "object",
          "required": [],
          "properties": {
            "sql": {
              "type": "string"
            },
            "args": {
              "type": "object"
            }
          },
          "additionalProperties": true
        },
        "output": {
          "type": "object",
          "required": [],
          "properties": {
            "rowCount": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Column"
              }
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "agent": {
          "type": "string"
        },
        "stepId": {
          "$ref": "#/$defs/ID"
        }
      },
      "additionalProperties": true
    },
    "TablePart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "columns",
        "rows",
        "rowCount"
      ],
      "properties": {
        "type": {
          "const": "table"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array"
          }
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "resultId": {
          "$ref": "#/$defs/ID"
        },
        "csvFileId": {
          "$ref": "#/$defs/ID"
        },
        "sqlPartId": {
          "$ref": "#/$defs/ID"
        },
        "stepId": {
          "$ref": "#/$defs/ID"
        },
        "source": {
          "type": "object",
          "required": [
            "views"
          ],
          "properties": {
            "views": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "elapsedMs": {
              "type": "integer",
              "minimum": 0
            },
            "asOf": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "FilePart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "fileId",
        "name",
        "mime",
        "sizeBytes"
      ],
      "properties": {
        "type": {
          "const": "file"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "fileId": {
          "$ref": "#/$defs/ID"
        },
        "name": {
          "type": "string"
        },
        "mime": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "rowCount": {
          "type": "integer",
          "minimum": 0
        },
        "previewable": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ImagePart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "blobId",
        "mime",
        "width",
        "height",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "image"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "blobId": {
          "$ref": "#/$defs/ID"
        },
        "mime": {
          "enum": [
            "image/png",
            "image/svg+xml",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "svgBlobId": {
          "$ref": "#/$defs/ID"
        }
      },
      "additionalProperties": true
    },
    "ChartPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "library",
        "spec",
        "alt"
      ],
      "properties": {
        "type": {
          "const": "chart"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "library": {
          "const": "vega-lite"
        },
        "spec": {
          "type": "object",
          "not": {
            "properties": {
              "data": {
                "required": [
                  "url"
                ]
              }
            },
            "required": [
              "data"
            ]
          }
        },
        "data": {
          "type": "object",
          "required": [
            "name",
            "values"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": true
        },
        "dataResultId": {
          "$ref": "#/$defs/ID"
        },
        "staticImageBlobId": {
          "$ref": "#/$defs/ID"
        },
        "title": {
          "type": "string"
        },
        "alt": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "CodePart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "language",
        "code"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "enum": [
            "query",
            "snippet",
            "spec"
          ]
        },
        "collapsed": {
          "type": "boolean"
        },
        "rerunnable": {
          "type": "boolean"
        },
        "stepId": {
          "$ref": "#/$defs/ID"
        }
      },
      "additionalProperties": true
    },
    "CalloutPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "variant",
        "items"
      ],
      "properties": {
        "type": {
          "const": "callout"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "variant": {
          "enum": [
            "assumption",
            "caveat",
            "data_quality",
            "phi_redaction",
            "info"
          ]
        },
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/ID"
              },
              "text": {
                "type": "string"
              },
              "editable": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "ArtifactPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "artifactId",
        "version",
        "kind",
        "title",
        "content"
      ],
      "properties": {
        "type": {
          "const": "artifact"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "artifactId": {
          "$ref": "#/$defs/ID"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "enum": [
            "table",
            "chart",
            "report",
            "code",
            "image"
          ]
        },
        "title": {
          "type": "string"
        },
        "content": {
          "anyOf": [
            {
              "$ref": "#/$defs/TablePart"
            },
            {
              "$ref": "#/$defs/ChartPart"
            },
            {
              "$ref": "#/$defs/CodePart"
            },
            {
              "$ref": "#/$defs/ImagePart"
            },
            {
              "type": "object",
              "required": [
                "markdown"
              ],
              "properties": {
                "markdown": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "autoOpen": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "ErrorPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "code",
        "title",
        "message",
        "retryable"
      ],
      "properties": {
        "type": {
          "const": "error"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "retryable": {
          "type": "boolean"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "AbstainPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "category",
        "reason",
        "suggestions"
      ],
      "properties": {
        "type": {
          "const": "abstain"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "category": {
          "enum": [
            "out_of_scope",
            "phi_request",
            "data_unavailable",
            "ambiguous",
            "low_confidence",
            "unsupported",
            "policy"
          ]
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "string",
          "maxLength": 500
        },
        "suggestions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/Suggestion"
          }
        }
      },
      "additionalProperties": true
    },
    "ClarificationPart": {
      "type": "object",
      "required": [
        "type",
        "id",
        "clarificationId",
        "question",
        "allowFreeText"
      ],
      "properties": {
        "type": {
          "const": "clarification"
        },
        "id": {
          "$ref": "#/$defs/ID"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
        },
        "sensitivity": {
          "$ref": "#/$defs/Sensitivity"
        },
        "createdAt": {
          "type": "string"
        },
        "clarificationId": {
          "$ref": "#/$defs/ID"
        },
        "question": {
          "type": "string"
        },
        "choices": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "allowFreeText": {
          "type": "boolean"
        },
        "multiSelect": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": "string"
        },
        "answered": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "Part": {
      "oneOf": [
        {
          "$ref": "#/$defs/TextPart"
        },
        {
          "$ref": "#/$defs/ReasoningPart"
        },
        {
          "$ref": "#/$defs/StatusPart"
        },
        {
          "$ref": "#/$defs/ToolCallPart"
        },
        {
          "$ref": "#/$defs/TablePart"
        },
        {
          "$ref": "#/$defs/FilePart"
        },
        {
          "$ref": "#/$defs/ImagePart"
        },
        {
          "$ref": "#/$defs/ChartPart"
        },
        {
          "$ref": "#/$defs/CodePart"
        },
        {
          "$ref": "#/$defs/CalloutPart"
        },
        {
          "$ref": "#/$defs/ArtifactPart"
        },
        {
          "$ref": "#/$defs/ErrorPart"
        },
        {
          "$ref": "#/$defs/AbstainPart"
        },
        {
          "$ref": "#/$defs/ClarificationPart"
        }
      ]
    },
    "MessageStart": {
      "type": "object",
      "required": [
        "type",
        "messageId",
        "conversationId",
        "contractVersion",
        "seq"
      ],
      "properties": {
        "type": {
          "const": "message.start"
        },
        "messageId": {
          "$ref": "#/$defs/ID"
        },
        "conversationId": {
          "$ref": "#/$defs/ID"
        },
        "contractVersion": {
          "type": "string",
          "pattern": "^1\\.\\d+\\.\\d+$"
        },
        "model": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "parentId": {
          "$ref": "#/$defs/ID"
