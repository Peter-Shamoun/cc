<mxfile host="drawio">
  <diagram id="40-analyzer" name="Agent analyzer">
    <mxGraphModel grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b style='font-size:20px'&gt;CLAIMCLARITY · AGENT ANALYZER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;one turn, from question to answer" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1200" height="36" as="geometry"/></mxCell>
        <mxCell id="lane-standard" value="STANDARD&lt;br&gt;KPI PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="lane-every" value="EVERY TURN" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="lane-custom" value="CUSTOM&lt;br&gt;ANALYSIS PATH" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="110" height="40" as="geometry"/></mxCell>
        <mxCell id="svc-chat" value="&lt;b&gt;1 · CHAT API&lt;/b&gt;&lt;br&gt;hands the question to a run worker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="150" y="308" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="agt-gate" value="&lt;b&gt;2 · KPI GATE&lt;/b&gt;&lt;br&gt;does one fixed KPI query fit?" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="300" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="svc-template" value="&lt;b&gt;3 · STANDARD KPI QUERY&lt;/b&gt;&lt;br&gt;fixed SQL, values bound" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="138" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="agt-writer" value="&lt;b&gt;4 · REPLY WRITER&lt;/b&gt;&lt;br&gt;1–3 sentences from the rows" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="130" width="240" height="80" as="geometry"/></mxCell>
        <mxCell id="svc-guard" value="&lt;b&gt;5 · SQL GUARD · READER&lt;/b&gt;&lt;br&gt;read-only session, one customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="800" y="308" width="260" height="64" as="geometry"/></mxCell>
        <mxCell id="agt-custom" value="&lt;b&gt;6 · CUSTOM ANALYSIS AGENT&lt;/b&gt;&lt;br&gt;writes and runs its own SQL" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="470" width="260" height="80" as="geometry"/></mxCell>
