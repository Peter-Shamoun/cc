        <mxCell id="title" value="&lt;b style='font-size:20px'&gt;CLAIMCLARITY · AGENT ANALYZER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;one turn, from question to answer · every hexagon calls Claude Haiku on Amazon Bedrock" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1300" height="36" as="geometry"/></mxCell>
