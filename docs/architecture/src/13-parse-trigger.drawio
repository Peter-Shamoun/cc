<mxfile host="drawio" pages="1"><diagram id="13-parse-trigger" name="Parse trigger"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1580" pageHeight="700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="13-parse-trigger-title" value="&lt;b style=&quot;font-size:20px;letter-spacing:0.04em;color:#1C2B57&quot;&gt;CLAIMCLARITY · PARSE TRIGGER&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;a complete day in raw/ starts one parser task for that customer · shown for Customer B&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="13-parse-trigger-crumb" value="&lt;span style=&quot;font-size:11px;color:#3A5A9E&quot;&gt;Overview › Ingestion &amp;amp; lake › Parse trigger&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="20" as="geometry" /></mxCell><mxCell id="trg-lane-start" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;START&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="30" y="240" width="120" height="40" as="geometry" /></mxCell><mxCell id="trg-lane-fail" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;ON FAILURE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="120" height="40" as="geometry" /></mxCell><mxCell id="trg-lane-roles" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&g