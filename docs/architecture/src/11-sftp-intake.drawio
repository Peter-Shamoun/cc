<mxfile host="drawio" pages="1"><diagram id="11-sftp-intake" name="SFTP intake"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1520" pageHeight="520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="11-sftp-intake-title" value="&lt;b style=&quot;font-size:20px;letter-spacing:0.04em;color:#1C2B57&quot;&gt;CLAIMCLARITY · SFTP INTAKE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;how a customer&#x27;s EDI files reach raw/ · shown for Customer B&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="11-sftp-intake-crumb" value="&lt;span style=&quot;font-size:11px;color:#3A5A9E&quot;&gt;Overview › Ingestion &amp;amp; lake › SFTP intake&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="20" as="geometry" /></mxCell><mxCell id="sftp-lane-in" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;DATA IN&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="30" y="165" width="120" height="40" as="geometry" /></mxCell><mxCell id="sftp-lane-checks" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;CHECKS ON&lt;br&gt;EVERY WRITE&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="30" y="350" width="120" height="50" as="geometry" /></mxCell><mxCell id="sftp-sender" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;1 · CUSTOMER B SENDER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;SFTP client with the customer&#x27;s SSH key&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="160" y="145" width="260" height="80" as="geometry" /></mxCell><mxCell id="sftp-transfer" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;2 · AWS TRANSFER FAMILY&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;home folder is Customer B&#x27;s raw/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="145" width="260" height="80" as="geometry" /></mxCell><mxCell id="sftp-raw" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;3 · CUSTOMER B&#x27;S RAW/&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;one folder per received day&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="850" y="145" width="280" height="80" as="geometry" /></mxCell><mxCell id="sftp-events" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;4 · EVENTBRIDGE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;see Parse trigger&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="14