<mxfile host="drawio"><diagram id="63-eval-regression" name="Eval regression"><mxGraphModel dx="1920" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="560" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;CLAIMCLARITY · EVAL REGRESSION&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;real questions feed a fixed test set · a change ships only if accuracy holds" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1C2B57;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="breadcrumb" value="Overview › Operations › Eval regression" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#3A5A9E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="20" as="geometry"/></mxCell><mxCell id="lane-collect" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A6BB0;strokeWidth=1.5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="820" height="170" as="geometry"/></mxCell><mxCell id="lane-collect-title" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.06em&quot;&gt;COLLECT&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane-collect"><mxGeometry x="14" y="6" width="792" height="22" as="geometry"/></mxCell><mxCell id="svc-sampled" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;1 · SAMPLED ANSWERS&lt;/b&gt;&lt;br&gt;Sampled transcripts and thumbs-down answers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=