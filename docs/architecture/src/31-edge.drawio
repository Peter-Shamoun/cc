<mxfile host="drawio"><diagram id="31-edge" name="Edge"><mxGraphModel dx="1580" dy="580" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1580" pageHeight="580" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;CLAIMCLARITY · EDGE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;one origin for the web app and the API · CloudFront, WAF, load balancer" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1C2B57;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="breadcrumb" value="Overview › Chat backend › Edge" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#3A5A9E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="20" as="geometry"/></mxCell><mxCell id="ext-browser" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;BROWSER&lt;/b&gt;&lt;br&gt;Loads the app and calls /api/* on the same origin" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="210" height="84" as="geometry"/></mxCell><mxCell id="svc-cloudfront" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;1 · CLOUDFRONT + WAF&lt;/b&gt;&lt;br&gt;TLS, WAF rules, then routes by path" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="330" y="232" width="230" height="120" as="geometry"/></mxCell><mxCell id="lane-web" value="" st