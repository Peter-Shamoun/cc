<mxfile host="drawio" pages="1"><diagram id="14-parser-task" name="Parser task"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1480" pageHeight="850" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="14-parser-task-title" value="&lt;b style=&quot;font-size:20px;letter-spacing:0.04em;color:#1C2B57&quot;&gt;CLAIMCLARITY · PARSER TASK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;one Fargate task per batch · steps on the left, what each step touches on the right&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="14-parser-task-crumb" value="&lt;span style=&quot;font-size:11px;color:#3A5A9E&quot;&gt;Overview › Ingestion &amp;amp; lake › Parser task&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="20" as="geometry" /></mxCell><mxCell id="pt-task" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1C2B57;dashed=1;dashPattern=6 4;strokeWidth=1.5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="60" y="100" width="600" height="680" as="geometry" /></mxCell><mxCell id="pt-task-title" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.06em;font-size:11px&quot;&gt;FARGATE TASK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:11px&quot;&gt;Customer B&#x27;s parser role · lives for one batch&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="pt-task"><mxGeometry x="14" y="6" width="572" height="22" as="geometry" /></mxCell><mxCell id="pt-step1" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;1 · START&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;takes the batch lease in staging/&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-task"><mxGeometry x="20" y="50" width="560" height="80" as="geometry" /></mxCell><mxCell id="pt-step2" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;2 · PARSE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;reads new raw files, quarantines bad ones&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-task"><mxGeometry x="20" y="180" width="560" height="80" as="geometry" /></mxCell><mxCell id="pt-step3" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;3 · SILVER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;writes part files, then the commit record&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-task"><mxGeometry x="20" y="310" width="560" height="80" as="geometry" /></mxCell><mxCell id="pt-step4" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;4 · GOLD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;builds a new version, moves CURRENT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middl