 value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;7 · RAW/ · BRONZE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;read only, by object version&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-prefix"><mxGeometry x="20" y="180" width="480" height="80" as="geometry" /></mxCell><mxCell id="pt-zone8" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;8 · PARQUET/ · SILVER&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;lossless part files&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-prefix"><mxGeometry x="20" y="310" width="480" height="80" as="geometry" /></mxCell><mxCell id="pt-zone9" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;9 · SEMANTIC_LAYER/ · GOLD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;data files, manifests, CURRENT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="pt-prefix"><mxGeometry x="20" y="440" width="480" height="80" as="geometry" /></mxCell><mxCell id="pt-logs" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em;font-size:13px&quot;&gt;10 · CLOUDWATCH LOGS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;run summary, no PHI&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" 