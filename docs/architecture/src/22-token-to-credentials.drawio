<mxfile host="drawio"><diagram id="22-token-to-credentials" name="Token to credentials"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px;color:#1C2B57;letter-spacing:0.04em'&gt;CLAIMCLARITY · IDENTITY &amp;amp; ACCESS&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px'&gt;token to credentials: gates 4, 5 and 6 on every question&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="32" as="geometry"/></mxCell><mxCell id="crumb" value="Overview › Identity &amp;amp; access › Token to credentials" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="900" height="20" as="geometry"/></mxCell><mxCell id="lane-question" value="EACH QUESTION" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="160" height="20" as="geometry"/></mxCell><mxCell id="ext-browser" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;1 · BROWSER&lt;/b&gt;&lt;br&gt;sends the cc_session cookie" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="190" height="64" as="geometry"/></mxCell><mxCell id="svc-chat" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;2 · CHAT API&lt;/b&gt;&lt;br&gt;reads the customer from the token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="190" width="220" height="64" as="geometry"/></mxCell><mxCell id="svc-worker" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;3 · RUN WORKER&lt;/b&gt;&lt;br&gt;holds the token for this run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="650" y="190" width="200" height="64" as="geometry"/></mxCell><mxCell id="svc-sts" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;4 · AWS STS&lt;/b&gt;&lt;br&gt;AssumeRoleWithWebIdentity" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="190" width="200" height="64" as="geometry"/></mxCell><mxCell id="phi-read" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1C2B57;dashed=1;dashPattern=6 4;strokeWidth=1.5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1300" y="80" width="600" height="200" as="geometry"/></mxCell><mxCell id="phi-read-title" value="&lt;b style='letter-spacing:0.06em;color:#1C2B57'&gt;CUSTOMER B'S DATA&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="phi-read"><mxGeometry x="14" y="6" width="330" height="20" as="geometry"/></mxCell><mxCell id="svc-reader" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;5 · READER SESSION&lt;/b&gt;&lt;br&gt;DuckDB · B's 15-minute credentials" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="phi-read"><mxGeometry x="20" y="110" width="230" height="64" as="geometry"/></mxCell><mxCell id="svc-gold" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;6 · B'S GOLD PREFIX&lt;/b&gt;&lt;br&gt;current version only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="phi-read"><mxGeometry x="390" y="110" width="190" height="64" as="geometry"/></mxCell><mxCell id="gate-4" value="4" style="rhombus;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="280" y="153" width="30" height="30" as="geometry"/></mxCell><mxCell id="gate-4-q" value="Is the token valid?" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="210.0" y="113" width="170" height="36" as="geometry"/></mxCell><mxCell id="gate-5" value="5" style="rhombus;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="900" y="153" width="30" height="30" as="geometry"/></mxCell><mxCell id="gate-5-q" value="Does B's role trust this token?" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830.0" y="113" width="170" height="36" as="geometry"/></mxCell><mxCell id="gate-6" value="6" style="rhombus;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontStyle=1;fontSize=13;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1605" y="153" width="30" height="30" as="geometry"/></mxCell><mxCell id="gate-6-q" value="Do IAM and KMS allow this read?" style="text;html=1;align=center;verticalAlign=bottom;whiteSpace=wrap;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1545.0" y="113" width="150" height="36" as="geometry"/></mxCell><mxCell id="lane-checks" value="CHECKED AGAINST" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="160" height="20" as="geometry"/></mxCell><mxCell id="svc-jwks" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;7 · COGNITO SIGNING KEYS&lt;/b&gt;&lt;br&gt;public keys, cached" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="360" y="360" width="220" height="64" as="geometry"/></mxCell><mxCell id="svc-trust" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;8 · TRUST POLICY&lt;/b&gt;&lt;br&gt;B's role: audience, customer = B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="980" y="360" width="200" height="64" as="geometry"/></mxCell><mxCell id="svc-key" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;9 · CUSTOMER B'S KEY&lt;/b&gt;&lt;br&gt;decrypts B's objects via S3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1690" y="360" width="190" height="64" as="geometry"/></mxCell><mxCell id="e-browser-chat" value="cookie" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6BB0;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=