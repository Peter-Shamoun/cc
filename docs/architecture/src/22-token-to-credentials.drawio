<mxfile host="drawio"><diagram id="22-token-to-credentials" name="Token to credentials"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px;color:#1C2B57;letter-spacing:0.04em'&gt;CLAIMCLARITY · IDENTITY &amp;amp; ACCESS&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px'&gt;token to credentials: gates 4, 5 and 6 on every question&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="32" as="geometry"/></mxCell><mxCell id="crumb" value="Overview › Identity &amp;amp; access › Token to credentials" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="700" height="20" as="geometry"/></mxCell><mxCell id="lane-question" value="EACH QUESTION" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="180" height="20" as="geometry"/></mxCell><mxCell id="res-browser" value="&lt;b&gt;1 · Browser&lt;/b&gt;&lt;br&gt;sends cc_session" style="sketch=0;outlineConnect=0;fontColor=#232F3E;dashed=0;html=1;fontSize=11;fontFamily=Helvetica;aspect=fixed;align=center;fillColor=#232F3E;strokeColor=none;shape=mxgraph.aws4.client;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="56" y="206" width="48" height="48" as="geometry"/></mxCell><mxCell id="svc-chat" value="&lt;b style='color:#1C2B57'&gt;2 · CHAT API&lt;/b&gt;&lt;br&gt;customer from the token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=44;spacingRight=10;