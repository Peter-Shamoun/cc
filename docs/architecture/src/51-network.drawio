<mxfile host="drawio"><diagram id="51-network" name="Network"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px;color:#1C2B57;letter-spacing:0.04em'&gt;CLAIMCLARITY · NETWORK &amp;amp; SECURITY&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px'&gt;network: private subnets, VPC endpoints, one filtered egress&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="32" as="geometry"/></mxCell><mxCell id="crumb" value="Overview › Network &amp;amp; security › Network" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="900" height="20" as="geometry"/></mxCell><mxCell id="lane-req" value="REQUESTS" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="160" height="20" as="geometry"/></mxCell><mxCell id="ext-browser" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;1 · BROWSER&lt;/b&gt;&lt;br&gt;HTTPS only" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="180" height="64" as="geometry"/></mxCell><mxCell id="svc-edge" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;2 · CLOUDFRONT + WAF&lt;/b&gt;&lt;br&gt;VPC origin to the load balancer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10