<mxfile host="drawio"><diagram id="21-sign-in" name="Sign-in"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px;color:#1C2B57;letter-spacing:0.04em'&gt;CLAIMCLARITY · IDENTITY &amp;amp; ACCESS&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style='font-size:12px'&gt;sign-in: Entra ID, then Cognito, then an httpOnly session cookie&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="16" width="1000" height="32" as="geometry"/></mxCell><mxCell id="crumb" value="Overview › Identity &amp;amp; access › Sign-in" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="900" height="20" as="geometry"/></mxCell><mxCell id="lane-signin" value="SIGN-IN" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="160" height="20" as="geometry"/></mxCell><mxCell id="ext-browser" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;1 · BROWSER&lt;/b&gt;&lt;br&gt;opens the app without a session" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="200" height="64" as="geometry"/></mxCell><mxCell id="ext-entra" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;2 · MICROSOFT ENTRA ID&lt;/b&gt;&lt;br&gt;company login and MFA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="130" width="220" height="64" as="geometry"/></mxCell><mxCell id="svc-cognito" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;3 · AMAZON COGNITO&lt;/b&gt;&lt;br&gt;maps the user to one customer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="130" width="230" height="64" as="geometry"/></mxCell><mxCell id="svc-callback" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;4 · CHAT API SIGN-IN&lt;/b&gt;&lt;br&gt;trades the code for an id token" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="130" width="230" height="64" as="geometry"/></mxCell><mxCell id="svc-cookie" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;5 · SESSION COOKIE&lt;/b&gt;&lt;br&gt;cc_session · httpOnly · 60 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="130" width="230" height="64" as="geometry"/></mxCell><mxCell id="lane-refused" value="REFUSED" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#3A5A9E;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="160" height="20" as="geometry"/></mxCell><mxCell id="svc-refused-entra" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;6 · NOT ASSIGNED&lt;/b&gt;&lt;br&gt;user is not in an assigned group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="340" y="290" width="220" height="64" as="geometry"/></mxCell><mxCell id="svc-refused-cognito" value="&lt;b style='color:#1C2B57;letter-spacing:0.04em'&gt;7 · NO CUSTOMER&lt;/b&gt;&lt;br&gt;user has no customer mapping" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="230" height="64" as="geometry"/></mxCell><mxCell id="e-browser-entra" value="redirect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6BB0;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#3A5A9E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext-browser" target="ext-entra"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-entra-cognito" value="Entra token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6BB0;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#3A5A9E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext-entra" target="svc-cognito"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-cognito-callback" value="code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6BB0;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#3A5A9E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entr