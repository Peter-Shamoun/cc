<mxfile host="drawio" pages="1"><diagram id="12-s3-layout" name="S3 layout"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="0" pageScale="1" pageWidth="1660" pageHeight="820" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="12-s3-layout-title" value="&lt;b style=&quot;font-size:20px;letter-spacing:0.04em;color:#1C2B57&quot;&gt;CLAIMCLARITY · S3 LAYOUT&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;font-size:12px&quot;&gt;one customer&#x27;s prefix in the ClaimClarity bucket · shown for Customer B&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1500" height="34" as="geometry" /></mxCell><mxCell id="12-s3-layout-crumb" value="&lt;span style=&quot;font-size:11px;color:#3A5A9E&quot;&gt;Overview › Ingestion &amp;amp; lake › S3 layout&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1200" height="20" as="geometry" /></mxCell><mxCell id="lay-head-writers" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;WRITERS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="24" as="geometry" /></mxCell><mxCell id="lay-head-readers" value="&lt;b style=&quot;font-size:12px;color:#3A5A9E&quot;&gt;READERS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fontColor=#1A1D23;" vertex="1" parent="1"><mxGeometry x="1340" y="100" width="280" height="24" as="geometry" /></mxCell><mxCell id="lay-bucket" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A6BB0;strokeWid