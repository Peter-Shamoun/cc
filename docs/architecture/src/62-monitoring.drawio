<mxfile host="drawio"><diagram id="62-monitoring" name="Monitoring"><mxGraphModel dx="1760" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="620" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;CLAIMCLARITY · MONITORING&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;logs become metrics, metrics drive alarms" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1C2B57;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="breadcrumb" value="Overview › Operations › Monitoring" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#3A5A9E;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="900" height="20" as="geometry"/></mxCell><mxCell id="svc-chat" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;1 · CHAT API AND RUN WORKERS&lt;/b&gt;&lt;br&gt;Redacted logs, one metric record per answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="250" height="80" as="geometry"/></mxCell><mxCell id="svc-parser" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;2 · PARSER TASK&lt;/b&gt;&lt;br&gt;Files parsed, failed and quarantined" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="280" width="250" height="80" as="geometry"/></mxCell><mxCell id="svc-sqs" value="&lt;b style=&quot;co