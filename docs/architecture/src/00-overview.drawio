<mxfile host="drawio"><diagram id="00-overview" name="Overview"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style='font-size:20px'&gt;CC · ARCHITECTURE OVERVIEW&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;claims analytics chat for clinical labs · numbers link to the area pages" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1C2B57;fontFamily=Helvetica;fontColor=#1C2B57;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1100" height="36" as="geometry"/></mxCell><mxCell id="grp-aws" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A6BB0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="1240" height="830" as="geometry"/></mxCell><mxCell id="lbl-aws" value="&lt;b&gt;AWS ACCOUNT · CC&lt;/b&gt;&amp;nbsp; all tasks on Amazon ECS on AWS Fargate in private subnets" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#1A1D23;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="334" y="88" width="700" height="24" as="geometry"/></mxCell><mxCell id="ext-labs" value="&lt;b&gt;1 · CUSTOMER LABS&lt;/b&gt;&lt;br&gt;Daily 837 · 835 · 277 files over SFTP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="230" height="72" as="geometry"/></mxCell><mxCell id="ext-users" value="&lt;b&gt;2 · XIFIN USERS&lt;/b&gt;&lt;br&gt;Browser · React chat app" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="484" width="230" height="72" as="geometry"/></mxCell><mxCell id="ext-entra" value="&lt;b&gt;3 · MICROSOFT ENTRA ID&lt;/b&gt;&lt;br&gt;Company sign-in" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="664" width="230" height="72" as="geometry"/></mxCell><mxCell id="svc-ingest" value="&lt;b&gt;4 · INGESTION &amp;amp; LAKE&lt;/b&gt;&lt;br&gt;Transfer Family → raw → parser task (Fargate)&lt;br&gt;→ lossless (silver) → semantic (gold) · gates 1–3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="136" width="390" height="80" as="geometry"/></mxCell><mxCell id="phi-bucket" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1C2B57;dashed=1;dashPattern=6 4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="860" y="116" width="660" height="120" as="geometry"/></mxCell><mxCell id="svc-bucket" value="&lt;b&gt;5 · CC BUCKET (S3)&lt;/b&gt;&lt;br&gt;One prefix, one KMS key and one IAM role per customer&lt;br&gt;raw · silver · gold · conversations · run events · audit" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="136" width="620" height="80" as="geometry"/></mxCell><mxCell id="lbl-phi" value="PHI BOUNDARY · per customer" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#1C2B57;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="866" y="238" width="260" height="18" as="geometry"/></mxCell><mxCell id="svc-edge" value="&lt;b&gt;6 · EDGE&lt;/b&gt;&lt;br&gt;CloudFront + WAF · static app from S3&lt;br&gt;load balancer → chat API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="380" y="480" width="270" height="80" as="geometry"/></mxCell><mxCell id="svc-chat" value="&lt;b&gt;7 · CHAT BACKEND&lt;/b&gt;&lt;br&gt;Chat API · SQS run queue · run workers&lt;br&gt;streams each answer (SSE)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="710" y="480" width="300" height="80" as="geometry"/></mxCell><mxCell id="agt-analyzer" value="&lt;b&gt;8 · ANALYZER&lt;/b&gt;&lt;br&gt;Strands agent in the run worker&lt;br&gt;KPI gate → standard KPI or custom analysis" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1060" y="466" width="260" height="108" as="geometry"/></mxCell><mxCell id="svc-bedrock" value="&lt;b&gt;9 · AMAZON BEDROCK&lt;/b&gt;&lt;br&gt;Claude Haiku" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1370" y="480" width="160" height="80" as="geometry"/></mxCell><mxCell id="svc-identity" value="&lt;b&gt;10 · IDENTITY &amp;amp; ACCESS&lt;/b&gt;&lt;br&gt;Cognito id token names the customer&lt;br&gt;STS → that customer's role, 15 min" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlig