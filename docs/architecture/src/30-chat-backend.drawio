<mxfile host="drawio"><diagram id="30-chat-backend" name="Chat backend"><mxGraphModel dx="1680" dy="540" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1680" pageHeight="540" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&quot;font-size:20px&quot;&gt;CLAIMCLARITY · CHAT BACKEND&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;a question goes in at the edge, runs on a worker and streams back" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#1C2B57;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="32" as="geometry"/></mxCell><mxCell id="lane-questions" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#4A6BB0;strokeWidth=1.5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1600" height="170" as="geometry"/></mxCell><mxCell id="lane-questions-title" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.06em&quot;&gt;QUESTIONS&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane-questions"><mxGeometry x="14" y="6" width="1572" height="22" as="geometry"/></mxCell><mxCell id="ext-browser" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;BROWSER&lt;/b&gt;&lt;br&gt;React chat app, reads the answer as a stream" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8A8E95;dashed=1;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-questions"><mxGeometry x="30" y="55" width="200" height="84" as="geometry"/></mxCell><mxCell id="svc-edge" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;1 · EDGE&lt;/b&gt;&lt;br&gt;CloudFront and WAF, then the load balancer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-questions"><mxGeometry x="290" y="55" width="200" height="84" as="geometry"/></mxCell><mxCell id="svc-chat-api" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;2 · CHAT API&lt;/b&gt;&lt;br&gt;Checks the token, queues a run, streams it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-questions"><mxGeometry x="550" y="55" width="200" height="84" as="geometry"/></mxCell><mxCell id="svc-sqs" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;3 · RUN QUEUE&lt;/b&gt;&lt;br&gt;Amazon SQS, one message per question" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-questions"><mxGeometry x="810" y="55" width="200" height="84" as="geometry"/></mxCell><mxCell id="svc-run-workers" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;4 · RUN WORKERS&lt;/b&gt;&lt;br&gt;ECS on Fargate, one run per question at a time" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-questions"><mxGeometry x="1070" y="55" width="200" height="84" as="geometry"/></mxCell><mxCell id="agent-analyzer" value="&lt;b style=&quot;font-size:13px;letter-spacing:0.04em&quot;&gt;ANALYZER&lt;/b&gt;&lt;br&gt;KPI gate → standard KPI or custom analysis" style="shape=hexagon;perimeter=hexagonPerimeter2;size=0.12;whiteSpace=wrap;html=1;fillColor=#1C2B57;strokeColor=#1C2B57;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane-questions"><mxGeometry x="1330" y="50" width="250" height="94" as="geometry"/></mxCell><mxCell id="lane-state" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#1C2B57;dashed=1;dashPattern=6 4;strokeWidth=1.5;container=1;pointerEvents=0;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="1600" height="150" as="geometry"/></mxCell><mxCell id="lane-state-title" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.06em&quot;&gt;CHAT STATE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#1A1D23&quot;&gt;ClaimClarity bucket, customer&amp;#x27;s prefix and key&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="lane-state"><mxGeometry x="14" y="6" width="1572" height="22" as="geometry"/></mxCell><mxCell id="svc-chat-state" value="&lt;b style=&quot;color:#1C2B57;letter-spacing:0.04em&quot;&gt;5 · CHAT STATE&lt;/b&gt;&lt;br&gt;Conversations, run events and the agent audit in S3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF0F9;strokeColor=#4A6BB0;fontColor=#1A1D23;align=left;spacingLeft=14;spacingRight=10;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="lane-state"><mxGeometry x="550" y="50" width="720" height="70" as="geometry"/></mxCell><mxCell id="edge-browser-edge" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#4A6BB0;strokeWidth=1.5;endArrow=block;endFill=1;endSize=6;fontSize=11;fontColor=#3A5A9E;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ext-browser" target="svc-edge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="edge-edge-api" value="/api/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogon