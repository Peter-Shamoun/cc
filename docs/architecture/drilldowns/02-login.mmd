%% 02 Login & customer mapping. Order: user -> Entra ID -> Cognito -> token.
flowchart LR
  subgraph browser["Browser"]
    user["User"]
    cookie[/"Session cookie<br/>ID token · httpOnly · Secure"/]
  end
  subgraph entraT["Microsoft Entra ID tenant"]
    entra["Microsoft Entra ID<br/>company sign-in"] -->|member of| group["Assigned group<br/>ClaimClarity · customer B"]
  end
  subgraph cog["Amazon Cognito"]
    pool["User pool<br/>federated with Entra ID"] -->|look up| map[["Group → customer<br/>one group maps to exactly one customer"]]
    map -->|issue| token[/"ID token<br/>customer = B · 60 min"/]
  end
  user -->|sign in| entra
  entra -->|federate| pool
  group -->|group claim| map
  token -.->|set cookie| cookie
  cookie -->|every request| g4{{"Gate 4 · token valid"}} --> api["Chat API (Fargate)"]
  g4 -.->|DENIED: invalid or expired| reject["Rejected · sign in again"]
