%% 00 Storage & isolation. Source of truth for the drill-down. Gates are nodes on the edges they guard.
%% Chat transcripts / conversation storage are out of scope (no conversations/, run-events/, transcript role or key).
%% No landing or staging prefix: SFTP writes straight to raw/; the batch lease is a lock owned by the parser (see 01).
flowchart LR
  sftp["AWS Transfer Family (SFTP intake)<br/>SFTP copy role B"]
  custA["Customer A roles"]
  subgraph bucket["S3 · ClaimClarity data bucket (one bucket, one prefix per customer)"]
    subgraph prefB["customer_b/ · bucket policy: customer B roles only"]
      raw[("raw/ · bronze<br/>Object Lock 7 yr · _SUCCESS last")]
      silver[("parquet/ · silver")]
      gold[("semantic_layer/ · gold<br/>CURRENT version")]
      quarantine[/"quarantine/ · 1 yr"/]
      audit[/"audit/ · write-once · 6 yr · hash-chained"/]
    end
  end
  qs["DuckDB query service<br/>reader role B"]
  keyB{{"KMS customer key B<br/>raw · silver · gold · quarantine"}}
  keyAudit{{"KMS platform audit key<br/>audit/ · one key-policy statement per customer"}}
  roles{{"Roles B: SFTP copy · parser · reader · audit (IAM prefix policies keep them apart)"}}

  sftp -->|write| raw
  raw --> g3{{"Gate 3 · IAM + KMS (parser)"}} -->|parse| silver
  silver -->|publish| gold
  raw -.->|bad files| quarantine
  gold --> g6{{"Gate 6 · IAM + KMS (reader)"}} -->|read| qs
  custA -->|DENIED by bucket policy + KMS| prefB
  keyB -.- raw
  keyB -.- silver
  keyB -.- gold
  keyB -.- quarantine
  keyAudit -.- audit
  record[/"audit record (JSON Lines, one per SQL):<br/>ts · customer · user · run_id · seq · sql (first 500 chars) · tables · rows · ms · escalation_reason · prev_hash · hash"/]
  audit -.- record
  roles -.- prefB
