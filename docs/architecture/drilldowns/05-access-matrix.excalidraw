   "locked": false,
   "text": "Shown for customer B. Every customer has the same roles, each limited to its own prefix and key.",
   "originalText": "Shown for customer B. Every customer has the same roles, each limited to its own prefix and key.",
   "fontSize": 20,
   "fontFamily": 5,
