  },
  {
   "id": "text_2302",
   "type": "text",
   "x": 40,
   "y": 950,
   "width": 1169.2800000000002,
   "height": 45.0,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
