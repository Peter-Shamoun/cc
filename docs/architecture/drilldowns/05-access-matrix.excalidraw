   "roundness": null,
   "seed": 2302,
   "version": 1,
   "versionNonce": 6906,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "raw/ and audit/ are write-once (Object Lock): no role can change or delete them, including the ones that write them.\n\"Only after escalation\" is enforced by the SQL guard; IAM allows the read.",
   "originalText": "raw/ and audit/ are write-once (Object Lock): no role can change or delete them, including the ones that write them.\n\"Only after escalation\" is enforced by the SQL guard; IAM allows the read.",
   "fontSize": 18,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true,
   "baseline": 18
  },
