      rules["Rules from past mistakes"]
      gloss["EDI business glossary"]
      schema["Semantic layer schema + allowed values"]
    end
    rules --> agent
    gloss --> agent
    schema --> agent
    sys["System prompt + conversation history (prompt cached)<br/>User newest prompt"] --> agent
    tools["Tool & CLI reference (prompt cached)"] --> agent
    agent["Claude Haiku · one agent<br/>(Strands on Amazon Bedrock)"]
