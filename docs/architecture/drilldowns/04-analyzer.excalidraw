  {
   "id": "9kVIq4ZuaAcGZISSBzOV3",
   "type": "text",
   "x": -1695.0827595789324,
   "y": 937.3879666756104,
   "width": 1886.3590087890625,
   "height": 70,
   "angle": 0,
   "strokeColor": "#1e1e1e",
